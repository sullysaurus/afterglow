<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Afterglow Clean Ad End</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@500&family=Manrope:wght@600;700&family=Unbounded:wght@600;700&display=swap');
      * { box-sizing:border-box; }
      html, body { width:100%; height:100%; margin:0; overflow:hidden; }
      astro-dev-toolbar { display:none !important; }
      body { color:#f7f3ec; background:#08060b; }
      main { position:relative; width:100vw; height:100vh; overflow:hidden; padding:13vh 6.7vw 15vh; background:radial-gradient(circle at 82% 12%,rgba(255,79,163,.2),transparent 27%),radial-gradient(circle at 15% 70%,rgba(120,228,211,.12),transparent 26%),#08060b; }
      main::before { content:''; position:absolute; inset:0; opacity:.1; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.42'/%3E%3C/svg%3E"); }
      .brand { display:flex; align-items:center; gap:2.2vw; font:600 2.1vw/1.05 'Unbounded',sans-serif; letter-spacing:.08em; }
      .mark { display:grid; place-items:center; width:8vw; aspect-ratio:1; border:1px solid rgba(255,255,255,.7); font-size:4vw; }
      .brand em { color:#ff4fa3; font-style:normal; }
      h1 { margin:5.2vh 0 0; font:700 8.9vw/.94 'Unbounded',sans-serif; letter-spacing:-.07em; text-transform:uppercase; }
      h1 i { display:block; color:#ff4fa3; font:italic 400 9.8vw/.9 Georgia,serif; text-transform:none; }
      .dashboard { position:relative; z-index:2; margin:5vh -1vw 3.2vh; padding:1.3vw; border:2px solid #ff4fa3; background:#0d0b11; box-shadow:0 0 7vw rgba(255,79,163,.23); transform:rotate(-1deg); }
      .dashboard img { display:block; width:100%; height:34vh; object-fit:cover; object-position:top center; }
      .message { margin:0; font:600 3vw/1.3 'Manrope',sans-serif; }
      .message strong { color:#d9ff52; }
      .cta { position:absolute; right:6.7vw; bottom:15vh; left:6.7vw; display:flex; justify-content:space-between; padding-top:2vh; border-top:1px solid rgba(255,255,255,.25); font:500 1.75vw/1 'DM Mono',monospace; }
      .cta strong { color:#d9ff52; font-size:2.2vw; }
    </style>
  </head>
  <body>
    <main>
      <div class="brand"><div class="mark">A✦</div><div>AFTERGLOW<br/><em>AUTOMATIONS</em></div></div>
      <h1>One custom<i>command center.</i></h1>
      <figure class="dashboard"><img src="/images/afterglow-dashboard-full.png" alt="Afterglow dashboard" /></figure>
      <p class="message"><strong>See what matters.</strong><br/>Automate what happens next.</p>
      <footer class="cta"><strong>DM “DASHBOARD” →</strong><span>afterglowautomations.com</span></footer>
    </main>
  </body>
</html>
